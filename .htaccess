# ============================================================
#  AK Fishers — SEO / URL configuration  (Apache · Hostinger)
# ============================================================

Options -MultiViews -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical target for every redirect below: https://akfishers.com
  # Each rule forces scheme + host + clean path in ONE hop (no redirect chains).
  # The /api/ backend is never rewritten (only HTTPS + www canonicalisation apply).

  # ---------------------------------------------------------
  # 1. Force HTTPS (also upgrades behind Hostinger's proxy)
  # ---------------------------------------------------------
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} =http
  RewriteRule ^ https://akfishers.com%{REQUEST_URI} [L,R=301]

  # ---------------------------------------------------------
  # 2. www  ->  non-www
  # ---------------------------------------------------------
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # ---------------------------------------------------------
  # 3. /index.html  or  /index  ->  /
  # ---------------------------------------------------------
  RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
  RewriteRule ^ https://akfishers.com/ [L,R=301]

  # ---- everything below leaves /api/ untouched ----
  RewriteRule ^api/ - [L]

  # ---------------------------------------------------------
  # 4. /page.html  ->  /page   (single hop, forces canonical host)
  # ---------------------------------------------------------
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
  RewriteRule ^ https://akfishers.com/%1 [L,R=301]

  # ---------------------------------------------------------
  # 5. Strip trailing slash, except the root
  # ---------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ https://akfishers.com/$1 [L,R=301]

  # ---------------------------------------------------------
  # 6. Serve /page internally from /page.html  (no redirect)
  # ---------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]
</IfModule>

# ============================================================
#  Protect backend internals
# ============================================================
# Deny direct access to SQL dumps and the /db folder
<FilesMatch "\.(sql|sqlite|md)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/db(/|$)

# Deny the API config files even if one is ever placed under /api
<FilesMatch "^(config|_bootstrap)\.php$">
  Require all denied
</FilesMatch>
<Files "config.sample.php">
  Require all denied
</Files>

# ============================================================
#  Custom error page
# ============================================================
ErrorDocument 404 /404.html

# ============================================================
#  Compression + caching (perf only — no behaviour change)
# ============================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml application/xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                 "access plus 7 days"
  ExpiresByType application/javascript    "access plus 7 days"
  ExpiresByType image/svg+xml             "access plus 30 days"
  ExpiresByType image/webp                "access plus 30 days"
  ExpiresByType image/jpeg                "access plus 30 days"
  ExpiresByType image/png                 "access plus 30 days"
  ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

# ============================================================
#  Security headers
# ============================================================
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
